# WireGuard Development Server Configuration
# =============================================
# 
# Ce fichier contient la configuration pour le serveur WireGuard de test.
# Les valeurs réelles doivent rester hors du contrôle de version.
#
# Pour utiliser un vrai serveur WireGuard :
# 1. Installer WireGuard sur un serveur (Debian/Ubuntu recommandé)
# 2. Configurer wg0 avec un pair pour le client
# 3. Remplir les valeurs ci-dessous dans le fichier .env (non versionné)
# 4. Le mode passera automatiquement de SIMULATION à LIVE
#
# Si ces valeurs sont vides ou absentes, le mode SIMULATION est activé.

# Clé publique du serveur WireGuard (base64, 44 caractères)
# Générée par : wg genkey | pubkey
WIREGUARD_SERVER_PUBLIC_KEY=

# Endpoint du serveur WireGuard (IP ou hostname:port)
# Exemple : vpn.example.com:51820
WIREGUARD_ENDPOINT=

# Serveur DNS utilisé dans le tunnel
WIREGUARD_DNS=1.1.1.1

# Adresse IP du client dans le tunnel
WIREGUARD_CLIENT_ADDRESS=10.8.0.2/32

# =============================================
# Serveur WireGuard de test — Procédure d'installation
# =============================================
#
# Sur un serveur Debian/Ubuntu :
#
# apt install wireguard
#
# # Générer les clés serveur
# wg genkey | tee /etc/wireguard/server_private.key | pubkey > /etc/wireguard/server_public.key
# chmod 600 /etc/wireguard/server_private.key
#
# # Créer /etc/wireguard/wg0.conf :
# [Interface]
# PrivateKey = <server_private_key>
# Address = 10.8.0.1/24
# ListenPort = 51820
# PostUp = iptables -A FORWARD -i wg0 -j ACCEPT; iptables -t nat -A POSTROUTING -o eth0 -j MASQUERADE
# PostDown = iptables -D FORWARD -i wg0 -j ACCEPT; iptables -t nat -D POSTROUTING -o eth0 -j MASQUERADE
#
# [Peer]
# PublicKey = <client_public_key>
# AllowedIPs = 10.8.0.2/32
#
# # Activer et démarrer
# systemctl enable wg-quick@wg0
# systemctl start wg-quick@wg0
#
# # Activer le forwarding IP
# echo "net.ipv4.ip_forward = 1" >> /etc/sysctl.conf
# sysctl -p
#
# # Ouvrir le port UDP 51820
# ufw allow 51820/udp
