# Variables d'environnement du backend VPN
# Copier ce fichier en .env et adapter les valeurs. Ne jamais versionner .env.

# Hôte et port d'écoute de l'API
HOST=0.0.0.0
PORT=3000

# Environnement : development | test | production
NODE_ENV=development

# Connexion PostgreSQL (Prisma)
# Remplacez l'utilisateur/mot de passe par vos identifiants locaux.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vpn

# Origines autorisées pour CORS (dev : '*' = tout autoriser)
CORS_ORIGIN=*
